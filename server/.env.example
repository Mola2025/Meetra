# ─── Mode développement sans PostgreSQL ───
# Commentez les lignes ci-dessous si vous utilisez PostgreSQL
USE_MEMORY_DB=true

# ─── Mode PostgreSQL (Supabase / local) ───
# Décommentez et ajustez l'URL de votre base de données
# DATABASE_URL=postgresql://postgres:MOTDEPASSE@localhost:5432/meetra_db
# Puis exécutez : cd server && node src/db/migrate.js

# ─── Général ───
JWT_SECRET=meetra-dev-secret-key-2026
PORT=4000
